---
interface Props {
    title: string;
    description: string;
    accent?: "primary" | "secondary";
}

const { title, description, accent = "primary" } = Astro.props;
---

<div
    class={`border-t-2 pt-6 ${accent === "primary" ? "border-primary" : "border-secondary"}`}
>
    <h3 class="text-base font-medium text-foreground">{title}</h3>
    <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
        {description}
    </p>
</div>
