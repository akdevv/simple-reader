// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id           String   @id @default(uuid())
  userId       String
  url          String

  status       ArticleStatus @default(PENDING)

  title        String?
  excerpt      String?
  siteName     String?

  sections     Json?
  media        Json?
  ttsAudio     Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

enum ArticleStatus {
  PENDING
  PROCESSING
  READY
  ERROR
  TTS_PROCESSING
  TTS_READY
}
