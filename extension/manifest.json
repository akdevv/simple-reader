{
  "manifest_version": 3,
  "name": "Simple Reader",
  "version": "0.1.0",
  "description": "Read any webpage aloud with a fully local TTS model and in-place sentence highlighting.",
  "permissions": ["offscreen", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Simple Reader"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
