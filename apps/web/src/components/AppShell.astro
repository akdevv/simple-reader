---
import { Icon } from "astro-icon/components";
import Base from "@/layouts/Base.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user!;
---

<Base title={title}>
  <div class="mx-auto flex min-h-screen max-w-5xl flex-col">
    <header class="flex items-center justify-between border-b border-border/60 px-6 py-4">
      <a href="/app" class="flex items-center gap-2.5">
        <Icon name="lucide:quote" class="size-5 text-primary" />
        <span class="font-serif font-semibold tracking-tight italic">
          simple reader
        </span>
      </a>
      <div class="flex items-center gap-4 text-sm text-muted-foreground">
        <a href="/app/notes" class="hover:text-foreground">
          Notes
        </a>
        <a href="/app/manage" class="hover:text-foreground">
          Tags & categories
        </a>
        <span>{user.name}</span>
        <button
          id="sign-out"
          class="underline-offset-4 hover:text-foreground hover:underline"
        >
          Sign out
        </button>
      </div>
    </header>
    <main class="flex-1 px-6 py-10">
      <slot />
    </main>
  </div>
</Base>

<script>
  document.getElementById("sign-out")!.addEventListener("click", async () => {
    await fetch("/api/auth/sign-out", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: "{}",
    });
    location.href = "/";
  });
</script>
