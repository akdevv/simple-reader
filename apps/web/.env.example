# Local: `docker compose up -d` at the repo root. Prod: Neon (injected by Vercel).
DATABASE_URL=postgres://sr:sr@localhost:5433/sr

# `openssl rand -base64 32`
BETTER_AUTH_SECRET=dev-secret-change-me-dev-secret-change-me
BETTER_AUTH_URL=http://localhost:4322

# Optional: each social button shows up once its pair is set.
# Callback: <BETTER_AUTH_URL>/api/auth/callback/{google,github}
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: auto-categorize with Gemini (aistudio.google.com/apikey).
# No key = new articles land in "Other" with no tags.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
