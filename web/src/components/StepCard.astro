---
interface Props {
    number: string;
    title: string;
    description: string;
}

const { number, title, description } = Astro.props;
---

<div class="border-t border-border pt-6">
    <span class="font-serif text-2xl italic text-secondary">{number}.</span>
    <h3 class="mt-3 text-base font-medium text-foreground">{title}</h3>
    <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
        {description}
    </p>
</div>
